{
  "schemaVersion": 5,
  "serverId": "REPLACE_WITH_ALLOCATED_SERVER_UUID",
  "serverName": "PlexonCraft",
  "relayUrl": "wss://YOUR-RELAY.workers.dev/v1/agent",
  "relayPublicKey": "REPLACE_WITH_RELAY_PUBLIC_KEY",
  "serverRoot": "/srv/plexonpanel/servers/plexoncraft/server",
  "dataDirectory": "/var/lib/plexonpanel/instances/plexoncraft",
  "accessRegistry": "/var/lib/plexonpanel/instances/plexoncraft/access/devices.json",
  "serviceName": "minecraft@plexoncraft.service",
  "capabilities": {
    "telemetry.view": true,
    "server.status": true,
    "settings.view": true,
    "audit.view.self": true,
    "audit.view": true,
    "devices.view": true,
    "devices.revoke": false,
    "console.view.errors": false,
    "console.view.full": false,
    "server.start": false,
    "server.stop": false,
    "server.restart": false,
    "files.list": false,
    "files.read": false,
    "files.download": false,
    "files.write": false,
    "files.create": false,
    "files.rename": false,
    "files.delete": false,
    "files.upload": false,
    "backup.view": false,
    "backup.create": false,
    "backup.download": false,
    "backup.delete": false,
    "backup.restore": false,
    "maintenance.view": false,
    "maintenance.configure": false,
    "maintenance.restart": false,
    "maintenance.run": false,
    "provider.view": false,
    "provider.test": false
  },
  "backups": {
    "enabled": false,
    "directory": "/var/backups/plexonpanel/instances/plexoncraft",
    "include": [
      "world",
      "world_nether",
      "world_the_end",
      "plugins",
      "bukkit.yml",
      "spigot.yml",
      "config"
    ],
    "retentionCount": 7,
    "intervalMinutes": 0,
    "maximumBytes": 21474836480,
    "restoreEnabled": false,
    "rcloneExecutable": "/usr/bin/rclone",
    "rcloneRemote": "",
    "rcloneConfig": "/etc/plexonpanel/instances/plexoncraft/rclone.conf",
    "liveSnapshotExcludes": [
      "logs",
      "crash-reports",
      "cache",
      ".cache",
      "tmp",
      "plugins/spark/tmp"
    ]
  },
  "console": {
    "enabled": false,
    "source": "JOURNALD",
    "journalExecutable": "/usr/bin/journalctl",
    "initialReplayLines": 500,
    "recentLines": 2500,
    "queueCapacity": 4096,
    "batchSize": 100,
    "batchIntervalMillis": 200,
    "maximumLineBytes": 8192,
    "cursorPersistenceMillis": 1000,
    "redactPatterns": []
  },
  "commandChannel": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 25575,
    "secretFile": "/etc/plexonpanel/instances/plexoncraft/rcon.secret",
    "commandTimeoutMillis": 5000,
    "readinessTimeoutSeconds": 180
  },
  "fleet": {
    "nodeId": "REPLACE_WITH_PUBLIC_NODE_UUID",
    "instanceKey": "plexoncraft"
  }
}
