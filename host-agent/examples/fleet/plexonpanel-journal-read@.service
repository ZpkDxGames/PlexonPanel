[Unit]
Description=PlexonPanel paired journal read authority %i
After=local-fs.target
Before=plexonpanel-host@%i.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/plexonpanel/instance-read-authority.py journal %i
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_FOWNER
ReadWritePaths=/var/log/journal/%m.plexonpanel-%i

[Install]
WantedBy=multi-user.target
