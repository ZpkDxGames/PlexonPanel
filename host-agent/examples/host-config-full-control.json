{
  "serverId": "REPLACE_WITH_EXISTING_PAPER_SERVER_UUID",
  "serverName": "PlexonCraft",
  "relayUrl": "wss://YOUR-RELAY.workers.dev/v1/agent",
  "relayPublicKey": "REPLACE_WITH_RELAY_PUBLIC_KEY",
  "serverRoot": "/opt/plexoncraft/server",
  "dataDirectory": "/var/lib/plexonpanel-host",
  "accessRegistry": "/opt/plexoncraft/server/plugins/PlexonPanel/access/devices.json",
  "serviceName": "plexoncraft.service",
  "capabilities": {
    "telemetry.view": true,
    "server.status": true,
    "settings.view": true,
    "audit.view.self": true,
    "audit.view": true,
    "devices.view": true,
    "devices.revoke": true,
    "server.start": true,
    "server.stop": true,
    "server.restart": true,
    "files.list": true,
    "files.read": true,
    "files.download": true,
    "files.write": true,
    "files.create": true,
    "files.rename": true,
    "files.delete": true,
    "files.upload": true,
    "backup.view": true,
    "backup.create": true,
    "backup.download": true,
    "backup.delete": true,
    "backup.restore": true
  },
  "backups": {
    "enabled": true,
    "directory": "/var/backups/plexonpanel",
    "include": [
      "world",
      "world_nether",
      "world_the_end",
      "plugins",
      "bukkit.yml",
      "spigot.yml",
      "config"
    ],
    "retentionCount": 7,
    "intervalMinutes": 0,
    "maximumBytes": 21474836480,
    "restoreEnabled": true,
    "rcloneExecutable": "/usr/bin/rclone",
    "rcloneRemote": "",
    "rcloneConfig": "/etc/plexonpanel-host/rclone.conf"
  }
}
