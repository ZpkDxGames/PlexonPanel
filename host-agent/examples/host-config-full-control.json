{
  "serverId": "REPLACE_WITH_EXISTING_PAPER_SERVER_UUID",
  "serverName": "PlexonCraft",
  "relayUrl": "wss://YOUR-RELAY.workers.dev/v1/agent",
  "relayPublicKey": "REPLACE_WITH_RELAY_PUBLIC_KEY",
  "serverRoot": "/opt/plexoncraft/server",
  "dataDirectory": "/var/lib/plexonpanel-host",
  "accessRegistry": "/opt/plexoncraft/server/plugins/PlexonPanel/access/devices.json",
  "serviceName": "plexoncraft.service",
  "capabilities": {
    "telemetry.view": true,
    "server.status": true,
    "settings.view": true,
    "audit.view.self": true,
    "audit.view": true,
    "devices.view": true,
    "devices.revoke": true,
    "console.view.errors": true,
    "console.view.full": true,
    "server.start": true,
    "server.stop": true,
    "server.restart": true,
    "files.list": true,
    "files.read": true,
    "files.download": true,
    "files.write": true,
    "files.create": true,
    "files.rename": true,
    "files.delete": true,
    "files.upload": true,
    "backup.view": true,
    "backup.create": true,
    "backup.download": true,
    "backup.delete": true,
    "backup.restore": true,
    "maintenance.view": true,
    "maintenance.configure": true,
    "maintenance.restart": true,
    "maintenance.run": true,
    "provider.view": true,
    "provider.test": true
  },
  "backups": {
    "enabled": true,
    "directory": "/var/lib/plexonpanel-host/backups",
    "include": [
      "world",
      "world_nether",
      "world_the_end",
      "plugins",
      "bukkit.yml",
      "spigot.yml",
      "config"
    ],
    "retentionCount": 7,
    "intervalMinutes": 0,
    "maximumBytes": 21474836480,
    "restoreEnabled": true,
    "rcloneExecutable": "/usr/bin/rclone",
    "rcloneRemote": "gdrive:PlexonCraft",
    "rcloneConfig": "/etc/plexonpanel-host/rclone.conf"
  },
  "console": {
    "enabled": true,
    "source": "JOURNALD",
    "journalExecutable": "/usr/bin/journalctl",
    "initialReplayLines": 500,
    "recentLines": 2500,
    "queueCapacity": 4096,
    "batchSize": 100,
    "batchIntervalMillis": 200,
    "maximumLineBytes": 8192,
    "cursorPersistenceMillis": 1000,
    "redactPatterns": []
  }
}
