[Unit]
Description=PlexonPanel Bedrock read-only Docker broker for %i
After=docker.service
AssertPathExists=/run/docker.sock
ConditionPathExists=/etc/plexonpanel-bedrock/%i/broker.properties

[Service]
Type=simple
User=root
Group=pph-tonimbedrock
UMask=0077
RuntimeDirectory=plexonpanel-bedrock
RuntimeDirectoryMode=0750
ExecCondition=/usr/bin/test %i = tonimbedrock
ExecStart=/usr/bin/java -Xms16m -Xmx128m -jar /opt/plexonpanel-bedrock/plexonpanel-bedrock-host.jar broker /etc/plexonpanel-bedrock/%i/broker.properties
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
RestrictRealtime=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
TasksMax=64

[Install]
WantedBy=multi-user.target
